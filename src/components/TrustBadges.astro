---
/**
 * Strip kecil logo legalitas & keanggotaan (Halal Indonesia, HPDKI, ASPAQIN, JULEHA).
 * Sengaja dibuat kecil: cukup sebagai bukti kepercayaan, tidak mengalahkan konten utama.
 * Ganti gambar: timpa `public/assets/images/logo-lain.png` (nama file sama).
 */
---

<section class="px-5 pt-6" aria-label="Legalitas dan keanggotaan">
  <div class="reveal rounded-xl border border-tan/40 bg-ivory px-4 py-3 text-center">
    <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-brown">Tersertifikasi &amp; Terdaftar Resmi</p>
    <img
      src="/assets/images/logo-lain.png"
      alt="Logo Halal Indonesia, HPDKI, Asosiasi Pengusaha Aqiqah Indonesia (ASPAQIN), dan Juru Sembelih Halal Indonesia (JULEHA)"
      width="600"
      height="139"
      loading="lazy"
      decoding="async"
      class="mx-auto mt-1 h-auto w-full max-w-[300px]"
    />
  </div>
</section>
