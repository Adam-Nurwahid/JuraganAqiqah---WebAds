---
// Ikon garis sederhana (stroke). Warna mengikuti currentColor.
interface Props {
  name:
    | 'shield'
    | 'star'
    | 'mosque'
    | 'heart'
    | 'check'
    | 'arrow'
    | 'phone'
    | 'mail'
    | 'map'
    | 'clock'
    | 'chevron'
    | 'menu'
    | 'close'
    | 'quote';
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'h-5 w-5', strokeWidth = 1.7 } = Astro.props;

const paths: Record<Props['name'], string> = {
  shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12.2 2.2 2.2 4.4-4.6"/>',
  star: '<path d="m12 3.2 2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-2.9-5.4 2.9 1.1-6-4.5-4.2 6.1-.8L12 3.2Z"/>',
  mosque:
    '<path d="M4 21V11.5M20 21V11.5M2.5 21h19"/><path d="M4 11.5 3 9.5h2l-1 2ZM20 11.5l-1-2h2l-1 2Z"/><path d="M7 21v-6.5a5 5 0 0 1 10 0V21"/><path d="M12 9.5c-2.6-1-3.6-2.8-2-4.6.9-1 2-1.4 2-2.9 0 1.5 1.1 1.9 2 2.9 1.6 1.8.6 3.6-2 4.6Z"/><path d="M10.5 21v-3a1.5 1.5 0 0 1 3 0v3"/>',
  heart: '<path d="M12 20s-7.5-4.6-7.5-10.1A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.7C19.5 15.4 12 20 12 20Z"/>',
  check: '<path d="m5 12.5 4.2 4.2L19 7"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  phone: '<path d="M5 3h3l2 5-2.5 1.5a14 14 0 0 0 6 6L15 13l5 2v3a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.2 2 2 0 0 1 5 3Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  map: '<path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  quote:
    '<path d="M9.5 6C6.5 7.4 4.5 10 4.5 13.4c0 2.6 1.6 4.4 3.9 4.4 2 0 3.4-1.4 3.4-3.3s-1.3-3.1-3.1-3.1M19 6c-3 1.4-5 4-5 7.4 0 2.6 1.6 4.4 3.9 4.4 2 0 3.4-1.4 3.4-3.3s-1.3-3.1-3.1-3.1"/>'
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
