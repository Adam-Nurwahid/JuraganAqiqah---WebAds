---
// Pemisah: garis emas tipis dengan ikon belah ketupat di tengah.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flex items-center justify-center gap-3 text-gold ${className}`} aria-hidden="true">
  <span class="h-px w-12 bg-gradient-to-r from-transparent to-gold sm:w-16"></span>
  <svg class="h-3 w-3" viewBox="0 0 12 12"><path d="M6 0 12 6 6 12 0 6Z" fill="currentColor" /></svg>
  <span class="h-px w-12 bg-gradient-to-l from-transparent to-gold sm:w-16"></span>
</div>
