---
import { siteData } from '../data/site.js';
import Icon from './ui/Icon.astro';

const year = new Date().getFullYear();
---

<footer class="bg-dark-brown px-5 pb-8 pt-10 text-center text-cream">
  <img src={siteData.images.logo} alt={`Logo ${siteData.brandName}`} width="64" height="64" loading="lazy" class="mx-auto h-16 w-16 rounded-full" />
  <p class="mt-3 font-serif text-xl font-bold text-cream">{siteData.brandName}</p>
  <p class="mt-1 font-serif text-base italic text-gold">“{siteData.tagline}”</p>

  <div class="mx-auto mt-6 max-w-sm space-y-3 border-t border-gold/20 pt-6 text-[15px] text-cream/80">
    <p class="flex items-start justify-center gap-2">
      <Icon name="map" class="mt-0.5 h-5 w-5 flex-none text-gold" />
      <span><span class="font-semibold text-gold">Area layanan:</span> {siteData.serviceAreas.join(', ')}</span>
    </p>
    <p class="flex items-start justify-center gap-2">
      <Icon name="phone" class="mt-0.5 h-5 w-5 flex-none text-gold" />
      <a href={`tel:+${siteData.whatsappNumbers[0]}`} class="hover:text-gold">{siteData.phoneDisplay}</a>
    </p>
    <p class="flex items-start justify-center gap-2">
      <Icon name="clock" class="mt-0.5 h-5 w-5 flex-none text-gold" />
      {siteData.operationalHours}
    </p>
    <p class="text-cream/70">{siteData.address}</p>
  </div>

  <p class="mt-6 text-sm text-cream/65">&copy; {year} {siteData.brandName}. Seluruh hak dilindungi.</p>
</footer>
