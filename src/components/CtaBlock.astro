---
import { siteData } from '../data/site.js';
import Button from './ui/Button.astro';

// Blok CTA WhatsApp yang bisa dipakai berulang di beberapa titik halaman.
interface Props {
  label?: string;
  message?: string;
  location: string;
  note?: string | false;
  class?: string;
}

const {
  label = siteData.ctaLabel,
  message = siteData.waMessages.promo,
  location,
  note = siteData.ctaNote,
  class: className = 'px-5 pt-8'
} = Astro.props;
---

<div class={`reveal ${className}`}>
  <Button whatsapp={message} location={location} size="lg" class="w-full">{label}</Button>
  {note && <p class="mt-3 text-center text-sm text-brown">{note}</p>}
</div>
