---
// Placeholder slot gambar: tampil selama `src` masih kosong.
interface Props {
  label: string;
  width: number;
  height: number;
  ratio: string;
  compact?: boolean;
}

const { label, width, height, ratio, compact = false } = Astro.props;
---

<div
  class="pattern-islamic flex w-full flex-col items-center justify-center border-2 border-dashed border-gold bg-sand text-center [--pattern-color:var(--brown)] [--pattern-opacity:0.1]"
  style={`aspect-ratio: ${width} / ${height}`}
  role="img"
  aria-label={`${label} (placeholder)`}
>
  <span class={`grid place-items-center rounded-full border border-gold bg-ivory text-caramel ${compact ? 'h-9 w-9' : 'h-14 w-14'}`}>
    <svg class={compact ? 'h-4 w-4' : 'h-7 w-7'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9.5" r="1.8" /><path d="m21 16-5-5-9 9" />
    </svg>
  </span>
  <span class={`mt-3 px-3 font-semibold uppercase tracking-wide text-maroon ${compact ? 'text-[11px] leading-tight' : 'text-base'}`}>{label}</span>
  <span class={`mt-1 px-3 text-brown ${compact ? 'text-[11px]' : 'text-sm'}`}>{width} x {height} px, {ratio === 'auto' ? 'tinggi bebas' : ratio}</span>
</div>
