---
// Slot video YouTube vertikal (9:16) dengan pola "facade": awalnya hanya thumbnail + tombol play,
// iframe YouTube baru dimuat saat diketuk. Halaman tetap ringan untuk trafik iklan.
interface Props {
  slot: {
    id: string;
    youtube: string;
    alt: string;
  };
}

const { slot } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${slot.youtube}/hqdefault.jpg`;
---

<div class="relative aspect-[9/16] w-full overflow-hidden bg-dark-brown">
  <button
    type="button"
    class="group absolute inset-0 block w-full"
    data-youtube-id={slot.youtube}
    data-youtube-title={slot.alt}
    data-video-location={slot.id}
    aria-label={`Putar video: ${slot.alt}`}
  >
    <!-- Thumbnail YouTube berformat 4:3, dipotong ke tengah agar video vertikal terisi penuh -->
    <img src={thumb} alt="" width="480" height="360" loading="lazy" decoding="async" class="h-full w-full object-cover" />
    <span class="absolute inset-0 bg-gradient-to-t from-dark-brown/60 via-transparent to-transparent" aria-hidden="true"></span>
    <span class="absolute left-1/2 top-1/2 grid h-16 w-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-maroon/90 text-gold shadow-lift transition-transform group-hover:scale-105" aria-hidden="true">
      <svg class="ml-1 h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
    </span>
    <span class="absolute inset-x-3 bottom-3 text-left text-sm font-semibold leading-snug text-cream">{slot.alt}</span>
  </button>
</div>
